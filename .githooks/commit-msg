#!/usr/bin/env bash
# Enforces Conventional Commits (https://www.conventionalcommits.org) so
# release-please can derive versions and changelogs from history.
# Skip once with: git commit --no-verify
set -euo pipefail

msg_file="$1"
subject="$(grep -v '^#' "$msg_file" | head -n 1)"

# Messages generated by git itself.
if [[ "$subject" =~ ^(Merge|Revert\ \"|fixup!|squash!|amend!) ]]; then
  exit 0
fi

types="feat|fix|perf|refactor|docs|style|test|build|ci|chore|revert"
pattern="^($types)(\([a-z0-9._/-]+\))?!?: [^ ].*$"

if [[ ! "$subject" =~ $pattern ]]; then
  cat >&2 <<MSG
commit-msg: the subject does not follow Conventional Commits.

  Got:      $subject
  Expected: <type>(<optional scope>)!: <description>

  Types:    ${types//|/, }
  Examples: feat(presentation): add monthly income chart
            fix: crash when deleting the last expense
            feat!: drop Android 7 support   (! = breaking change)

  release-please bumps: fix -> patch, feat -> minor, ! -> major.
MSG
  exit 1
fi

if (( ${#subject} > 100 )); then
  echo "commit-msg: subject is ${#subject} characters; keep it at 100 or fewer." >&2
  exit 1
fi
